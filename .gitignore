# Laufzeitdaten & Dumps (personenbezogen: enthalten die Loxone-Struktur)
data/*
!data/.gitkeep

# Lokale Konfiguration mit Zugangsdaten (Miniserver/T25-Passwörter)
config/loxpanel.cfg

# Panel-Profile mit der konkreten Raum-/Kategorie-Aufteilung (personenbezogen)
# Die .bak legt der Server bei JEDEM Speichern selbst an (_persist_panels_file,
# Sicherung vor dem Ueberschreiben) - sie enthaelt dieselben Daten.
config/panels.json
config/panels.json.bak

# Panel-lokale Kiosk-Konfig (Server-IP + Panel-ID, pro Geraet unterschiedlich)
deploy/loxpanel-kiosk.conf

# Docker-Umgebungsdatei mit Zugangsdaten
.env

# Python
*.pyc
__pycache__/
.venv/

# Lokal gebautes Overlay-Test-Plugin (Build-Artefakt, gehoert nicht ins Repo)
loxpanel-plugin-test.zip

# Globale Theme-/Kategorie-Farben (zur Laufzeit ueber die Config-UI geschrieben)
config/theme.json
